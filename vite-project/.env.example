# Loopback access is trusted only after server-side address/origin checks.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Optional initial remote password. Alternatively set it in Control on this machine.
# ACCESS_PASSWORD=choose-a-private-password-of-at-least-8-characters
# Legacy explicit CONTROL_TOKEN / CASTER_TOKEN / OVERLAY_TOKEN are optional.
HOK_CAPTURE_ENABLED=0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
# DATA_FILE=/persistent/path/match.json
# VITE_API_URL=https://broadcast.example.com
# VITE_WS_URL=wss://broadcast.example.com/ws
