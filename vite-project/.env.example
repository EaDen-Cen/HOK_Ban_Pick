# HOK Broadcast server
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Remote-access passwords are intentionally NOT given defaults.
# Recommended workflow: open local Control at http://127.0.0.1:3001/control,
# then use "Remote access passwords" to set Control/Caster/Overlay passwords.
#
# Optional deployment bootstrap: provide all three distinct passwords here.
# Once the local Control saves passwords they are persisted beside match.json.
# CONTROL_TOKEN=
# CASTER_TOKEN=
# OVERLAY_TOKEN=

# Optional legacy/native Windows host capture. Browser window capture does not need this.
HOK_CAPTURE_ENABLED=0

# Local Vite development origins. For a real domain, append the exact HTTPS origin:
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://broadcast.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001

# DATA_FILE=/persistent/path/match.json
# UPLOAD_DIR=/persistent/path/uploads/player-portraits

# Same-origin deployment is recommended. Only set these when frontend/backend
# are intentionally hosted at different origins.
# VITE_API_URL=https://broadcast.example.com
# VITE_WS_URL=wss://broadcast.example.com/ws
