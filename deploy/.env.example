# Replace with the domain you control.
DOMAIN=broadcast.example.com

# First deployment bootstrap only: choose three different passwords yourself.
# After Control is reachable, the director can rotate these from the
# "Remote access passwords" panel; there are no built-in/default passwords.
CONTROL_TOKEN=choose-your-control-password
CASTER_TOKEN=choose-your-caster-password
OVERLAY_TOKEN=choose-your-overlay-password

# Leave CPU headroom for OBS on a shared director/server machine.
HOK_RECOGNITION_THREADS=2
